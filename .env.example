# AudioFeel - API Keys
# Get your free Last.fm API key at: https://www.last.fm/api/account/create
LASTFM_API_KEY=your_lastfm_api_key_here

# Get your free TMDB API key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Get your Gemini API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Google Books API key (works without, but rate limits are lower)
# https://console.cloud.google.com/apis/credentials
GOOGLE_BOOKS_API_KEY=

# Server port (default 3001)
PORT=3001
